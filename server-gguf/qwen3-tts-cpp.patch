+// Each window also re-decodes the warmup context, so small chunks multiply vocoder work. Only the
+// first chunk needs to be small (it sets time to first audio). Each later chunk grows by half, up to
+// stream_chunk_frames(), so it is ready before the audio already sent has finished playing.
+int stream_first_chunk_frames() {
+    static const int v = [] {
+        if (const char * e = getenv("QWEN3_TTS_STREAM_FIRST_CHUNK_FRAMES")) {
+            int n = atoi(e);
+            if (n >= 4) return n;
+        }
+        return stream_chunk_frames();
+    }();
+    return v;
+}
 }  // namespace
 
